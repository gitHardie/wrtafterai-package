#!/bin/sh /etc/rc.common
# WrtAfterAI MCP Server - procd 服务

USE_PROCD=1
START=95
STOP=10

start_service() {
	local enabled
	config_load wrtafterai-mcp
	config_get_bool enabled server enabled 1
	[ "$enabled" = "1" ] || return 0

	procd_open_instance
	procd_set_param command /usr/bin/wrtafterai-mcp serve --http
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits core="0 0"
	procd_close_instance
}

reload_service() {
	stop
	start
}
